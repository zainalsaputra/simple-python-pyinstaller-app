node {
    def pythonImage = 'python:3.11-slim'
    def dockerArgs = '-u root:root'

    stage('Checkout') {
        checkout scm

        sh '''
            echo "Current workspace:"
            pwd
            echo "Workspace files:"
            ls -lah
        '''
    }

    stage('Build') {
        docker.image(pythonImage).inside(dockerArgs) {
            sh '''
                python --version
                python -m py_compile sources/add2vals.py sources/calc.py
            '''
        }
    }

    stage('Test') {
        docker.image(pythonImage).inside(dockerArgs) {
            sh '''
                pip install --no-cache-dir pytest
                mkdir -p test-reports
                pytest --verbose --junit-xml test-reports/results.xml sources/test_calc.py
            '''
        }

        junit 'test-reports/results.xml'
    }

    stage('Manual Approval') {
        input message: 'Lanjutkan ke tahap Deploy?'
    }

    stage('Deploy') {
        docker.image(pythonImage).inside(dockerArgs) {
            sh '''
                apt-get update
                apt-get install -y binutils
                pip install --no-cache-dir pyinstaller

                pyinstaller --onefile sources/add2vals.py

                echo "Application deployed successfully."
                echo "Running deployed executable for validation:"
                ./dist/add2vals 5 7

                echo "Application will stay available/running for 1 minute simulation."
                sleep 60

                echo "Deploy stage completed after 1 minute."
            '''
        }

        archiveArtifacts artifacts: 'dist/add2vals', fingerprint: true
    }

    stage('Archive Log') {
        sh '''
            cat > log.txt <<'EOF'
            CI/CD Pipeline Log Summary

            Pipeline Name:
            submission-cicd-pipeline-zainalsaputra

            Project:
            simple-python-pyinstaller-app

            Stages:
            - Checkout        : SUCCESS
            - Build           : SUCCESS
            - Test            : SUCCESS
            - Manual Approval : PROCEEDED
            - Deploy          : SUCCESS

            Build:
            Python source files were compiled successfully.

            Test:
            Unit tests were executed using pytest.
            JUnit test report was generated at test-reports/results.xml.

            Manual Approval:
            Pipeline was paused with the message:
            "Lanjutkan ke tahap Deploy?"

            Deploy:
            Python application was packaged using PyInstaller.
            The deployed executable was tested.
            Deploy stage was kept running for 1 minute using sleep 60.

            EOF
        '''

        archiveArtifacts artifacts: 'log.txt', fingerprint: true
    }
}